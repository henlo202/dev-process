{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontmatter of an artefact inside a project that follows dev-process",
  "type": "object",
  "required": [
    "artefact",
    "status",
    "updated"
  ],
  "properties": {
    "artefact": {
      "type": "string",
      "description": "Artefact id from process.yaml, e.g. requirements"
    },
    "status": {
      "enum": [
        "draft",
        "in-review",
        "approved",
        "in-progress",
        "done",
        "superseded"
      ]
    },
    "version": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gate": {
      "type": "string",
      "pattern": "^G\\d$",
      "description": "gate-record only"
    },
    "decision": {
      "enum": [
        "approved",
        "approved-with-conditions",
        "rejected"
      ],
      "description": "gate-record only"
    },
    "tier": {
      "enum": [
        "T1",
        "T2",
        "T3"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(REQ|NFR)-\\d+$"
      },
      "description": "increment only: requirement IDs in scope"
    },
    "increment": {
      "type": "string",
      "pattern": "^INC-\\d+$",
      "description": "increment only"
    },
    "release": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "gate-record G3 only: the release decided on"
    },
    "recorded_by": {
      "enum": [
        "owner",
        "agent"
      ],
      "description": "gate-record: who wrote the record (the decision is always the Owner's)"
    },
    "owner_statement": {
      "type": "string",
      "description": "gate-record: the Owner's decision, verbatim, when recorded by an agent"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artefact": {
            "const": "gate-record"
          }
        }
      },
      "then": {
        "required": [
          "gate",
          "decision",
          "tier"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "artefact": {
            "const": "increment"
          }
        }
      },
      "then": {
        "required": [
          "increment",
          "requirements"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "recorded_by": {
            "const": "agent"
          }
        },
        "required": [
          "recorded_by"
        ]
      },
      "then": {
        "required": [
          "owner_statement"
        ]
      }
    }
  ]
}
